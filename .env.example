# Copy this file to `.env` (project root or backend/) for local development.
# Never commit your real .env file. On Render, set these in the dashboard.

# "production" on Render (enables secure cookies, requires SECRET_KEY).
APP_ENV=development

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Leave empty to use SQLite at backend/instance/hostel.db.
# On Render this is filled in automatically from the Postgres database.
DATABASE_URL=

# Optional: custom SQLite file location (relative to backend/ or absolute).
# SQLITE_PATH=instance/hostel.db

# Creates (or promotes) an admin account at startup. Choose your own values.
# The password must be at least 8 characters. Existing passwords are not changed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Only needed if the frontend is hosted on a DIFFERENT origin than the API.
# Comma-separated, no trailing slash, e.g. https://hostel-frontend.onrender.com
# In development, Live Server (ports 5500/5501) is allowed automatically.
CORS_ORIGINS=

# Cookie settings: use None (with HTTPS) only for a separately hosted frontend.
SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_HOURS=8

# Local dev server only: set to 1 for auto-reload + debugger. Ignored in production.
FLASK_DEBUG=0
